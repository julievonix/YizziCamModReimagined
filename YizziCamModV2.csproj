<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>YizziCamModV2</AssemblyName>
    <RootNamespace>YizziCamModV2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <ManagedDir>$(GameDir)\Gorilla Tag_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <BepInExPluginsDir>$(GameDir)\BepInEx\plugins</BepInExPluginsDir>
  </PropertyGroup>

  <!-- BepInEx + Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity Engine -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(ManagedDir)\UnityEngine.XRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity packages (renamed in Unity 6) -->
  <ItemGroup>
    <Reference Include="Unity.Cinemachine">
      <HintPath>$(ManagedDir)\Unity.Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- TextMeshPro -->
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Photon -->
  <ItemGroup>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude the NowPlayingHelper sub-project from this project's compile -->
  <ItemGroup>
    <Compile Remove="NowPlayingHelper\**" />
    <EmbeddedResource Remove="NowPlayingHelper\**" />
    <None Remove="NowPlayingHelper\**" />
  </ItemGroup>

  <!-- Embedded asset bundles -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\YizziCamModV2.Assets.colorscreen">
      <LogicalName>YizziCamModV2.Assets.colorscreen</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\YizziCamModV2.Assets.yizzicam">
      <LogicalName>YizziCamModV2.Assets.yizzicam</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Atlas.png">
      <LogicalName>YizziCamModV2.Assets.Atlas</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_steam.png">
      <LogicalName>YizziCamModV2.Assets.platform_steam</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_meta.png">
      <LogicalName>YizziCamModV2.Assets.platform_meta</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_oculus_pc.png">
      <LogicalName>YizziCamModV2.Assets.platform_oculus_pc</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <DeployToBepInExPlugins Condition="'$(DeployToBepInExPlugins)' == ''">true</DeployToBepInExPlugins>
  </PropertyGroup>

  <!-- After each successful build → Gorilla Tag BepInEx\plugins ($(GameDir) must exist). -->
  <!-- Turn off for this build: dotnet build -p:DeployToBepInExPlugins=false -->
  <Target Name="DeployToBepInExPlugins" AfterTargets="Build" Condition="'$(DeployToBepInExPlugins)' != 'false'">
    <Warning
      Code="YIZZI7001"
      Text="Deploy skipped: Gorilla Tag folder not found at &quot;$(GameDir)&quot;. Set GameDir in this .csproj or install the game."
      Condition="!Exists('$(GameDir)')" />
    <PropertyGroup Condition="Exists('$(GameDir)')">
      <_YizziPdb>$(TargetDir)$(TargetName).pdb</_YizziPdb>
      <_NowPlayingOut>$(BepInExPluginsDir)\YizziNowPlaying</_NowPlayingOut>
    </PropertyGroup>
    <MakeDir Directories="$(BepInExPluginsDir)" Condition="Exists('$(GameDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(BepInExPluginsDir)\$(TargetFileName)" SkipUnchangedFiles="false" Condition="Exists('$(GameDir)')" />
    <Copy SourceFiles="$(_YizziPdb)" DestinationFolder="$(BepInExPluginsDir)" SkipUnchangedFiles="false" Condition="Exists('$(GameDir)') And Exists('$(_YizziPdb)')" />
    <Message Importance="high" Text="YizziCamModV2 → $(BepInExPluginsDir)\$(TargetFileName)" Condition="Exists('$(GameDir)')" />
    <!-- Build and deploy the NowPlayingHelper (song-info query tool) -->
    <Exec Command="C:\Users\Monk\.dotnet\dotnet.exe publish &quot;$(MSBuildThisFileDirectory)NowPlayingHelper\NowPlayingHelper.csproj&quot; -c Release -o &quot;$(_NowPlayingOut)&quot; --nologo -v q"
          Condition="Exists('$(GameDir)')"
          IgnoreExitCode="true" />
    <Message Importance="high" Text="YizziNowPlaying → $(_NowPlayingOut)" Condition="Exists('$(GameDir)')" />
  </Target>

</Project>
