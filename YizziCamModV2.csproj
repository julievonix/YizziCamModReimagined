<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>YizziCamModReimagend</AssemblyName>
    <RootNamespace>YizziCamModV2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <ManagedDir>$(GameDir)\Gorilla Tag_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <BepInExPluginsDir>$(GameDir)\BepInEx\plugins</BepInExPluginsDir>
  </PropertyGroup>

  <!-- BepInEx + Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity Engine -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(ManagedDir)\UnityEngine.XRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity packages (renamed in Unity 6) -->
  <ItemGroup>
    <Reference Include="Unity.Cinemachine">
      <HintPath>$(ManagedDir)\Unity.Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- TextMeshPro -->
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- PlayFab SDK (ships with Gorilla Tag) -->
  <ItemGroup>
    <Reference Include="PlayFab">
      <HintPath>$(ManagedDir)\PlayFab.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Photon -->
  <ItemGroup>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude the NowPlayingHelper sub-project from this project's compile -->
  <ItemGroup>
    <Compile Remove="NowPlayingHelper\**" />
    <EmbeddedResource Remove="NowPlayingHelper\**" />
    <None Remove="NowPlayingHelper\**" />
  </ItemGroup>

  <!-- Embedded asset bundles -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\YizziCamModV2.Assets.colorscreen">
      <LogicalName>YizziCamModV2.Assets.colorscreen</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\YizziCamModV2.Assets.yizzicam">
      <LogicalName>YizziCamModV2.Assets.yizzicam</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Atlas.png">
      <LogicalName>YizziCamModV2.Assets.Atlas</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_steam.png">
      <LogicalName>YizziCamModV2.Assets.platform_steam</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_meta.png">
      <LogicalName>YizziCamModV2.Assets.platform_meta</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\platform_oculus_pc.png">
      <LogicalName>YizziCamModV2.Assets.platform_oculus_pc</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\YizziTabletBevel.obj">
      <LogicalName>YizziCamModV2.Assets.YizziTabletBevel</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\YizziCamGun.stl">
      <LogicalName>YizziCamModV2.Assets.YizziCamGun</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <DeployToBepInExPlugins Condition="'$(DeployToBepInExPlugins)' == ''">true</DeployToBepInExPlugins>
  </PropertyGroup>

  <!-- After each successful build → Gorilla Tag BepInEx\plugins\YizziCamModReimagend\ -->
  <!-- Turn off for this build: dotnet build -p:DeployToBepInExPlugins=false -->
  <Target Name="DeployToBepInExPlugins" AfterTargets="Build" Condition="'$(DeployToBepInExPlugins)' != 'false'">
    <Warning
      Code="YIZZI7001"
      Text="Deploy skipped: Gorilla Tag folder not found at &quot;$(GameDir)&quot;. Set GameDir in this .csproj or install the game."
      Condition="!Exists('$(GameDir)')" />
    <PropertyGroup Condition="Exists('$(GameDir)')">
      <_YizziPdb>$(TargetDir)$(TargetName).pdb</_YizziPdb>
      <_ModDir>$(BepInExPluginsDir)\YizziCameraModReimagend</_ModDir>
      <_NowPlayingOut>$(_ModDir)\YizziNowPlaying</_NowPlayingOut>
    </PropertyGroup>

    <!-- Ensure the mod subfolder exists -->
    <MakeDir Directories="$(_ModDir)" Condition="Exists('$(GameDir)')" />

    <!-- Deploy DLL and PDB into the subfolder -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_ModDir)\$(TargetFileName)" SkipUnchangedFiles="false" Condition="Exists('$(GameDir)')" />
    <Copy SourceFiles="$(_YizziPdb)" DestinationFolder="$(_ModDir)" SkipUnchangedFiles="false" Condition="Exists('$(GameDir)') And Exists('$(_YizziPdb)')" />
    <Message Importance="high" Text="YizziCamModReimagend → $(_ModDir)\$(TargetFileName)" Condition="Exists('$(GameDir)')" />

    <!-- Remove any stale root-level or old-subfolder copies -->
    <Delete Files="$(BepInExPluginsDir)\$(TargetFileName)"                     Condition="Exists('$(BepInExPluginsDir)\$(TargetFileName)')" />
    <Delete Files="$(BepInExPluginsDir)\$(TargetName).pdb"                     Condition="Exists('$(BepInExPluginsDir)\$(TargetName).pdb')" />
    <Delete Files="$(BepInExPluginsDir)\YizziCamModV2.dll"                     Condition="Exists('$(BepInExPluginsDir)\YizziCamModV2.dll')" />
    <Delete Files="$(BepInExPluginsDir)\YizziCamGun.obj"                       Condition="Exists('$(BepInExPluginsDir)\YizziCamGun.obj')" />
    <Delete Files="$(BepInExPluginsDir)\YizziTabletBevel.obj"                  Condition="Exists('$(BepInExPluginsDir)\YizziTabletBevel.obj')" />
    <Delete Files="$(_ModDir)\YizziCamGun.obj"                                Condition="Exists('$(_ModDir)\YizziCamGun.obj')" />
    <Delete Files="$(_ModDir)\YizziTabletBevel.obj"                           Condition="Exists('$(_ModDir)\YizziTabletBevel.obj')" />
    <Delete Files="$(BepInExPluginsDir)\YizziCamModReimagend\$(TargetFileName)" Condition="Exists('$(BepInExPluginsDir)\YizziCamModReimagend\$(TargetFileName)')" />
    <Delete Files="$(BepInExPluginsDir)\YizziCamModReimagend\$(TargetName).pdb" Condition="Exists('$(BepInExPluginsDir)\YizziCamModReimagend\$(TargetName).pdb')" />
    <RemoveDir Directories="$(BepInExPluginsDir)\YizziNowPlaying"              Condition="Exists('$(BepInExPluginsDir)\YizziNowPlaying')" />

    <!-- Build and deploy the NowPlayingHelper nested inside the mod folder -->
    <Exec Command="C:\Users\Monk\.dotnet\dotnet.exe publish &quot;$(MSBuildThisFileDirectory)NowPlayingHelper\NowPlayingHelper.csproj&quot; -c Release -o &quot;$(_NowPlayingOut)&quot; --nologo -v q"
          Condition="Exists('$(GameDir)')"
          IgnoreExitCode="true" />
    <Message Importance="high" Text="YizziNowPlaying → $(_NowPlayingOut)" Condition="Exists('$(GameDir)')" />
  </Target>

</Project>
